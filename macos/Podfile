require 'pathname'

ws_dir = Pathname.new(__dir__)
ws_dir = ws_dir.parent until
  File.exist?("#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb") ||
  ws_dir.expand_path.to_s == '/'
require "#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb"

# New Architecture (Fabric) on macOS, matching iOS and the Phase A spikes.
ENV['RCT_NEW_ARCH_ENABLED'] ||= '1'

prepare_react_native_project!

target 'finny-macOS' do
  platform :macos, '14.0'
  use_native_modules!

  # Flags change depending on the env values.
  flags = get_default_flags()

  use_react_native!(
    :path => '../node_modules/react-native-macos',
    :fabric_enabled => ENV['RCT_NEW_ARCH_ENABLED'] == '1',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # Xcode 27 rejects deployment targets below its minimum (macOS 12.0); some
    # pods still declare older ones.
    installer.pods_project.targets.each do |t|
      t.build_configurations.each do |c|
        v = c.build_settings['MACOSX_DEPLOYMENT_TARGET']
        c.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '14.0' if v.nil? || Gem::Version.new(v) < Gem::Version.new('14.0')
      end
    end
    react_native_post_install(installer)
  end
end
