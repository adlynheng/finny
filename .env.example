# Copy to .env (git-ignored) and fill in. Babel inlines these into the JS bundle at build time
# (scripts/build-env.js), so after editing, restart Metro; the iOS .ipa picks them up when built.
# Both come from the Supabase dashboard: Project Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable (anon) key. It ships inside the app; the database grants it nothing.
SUPABASE_ANON_KEY=
